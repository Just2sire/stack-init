# ── Supabase ───────────────────────────────────────────────────────────────
# Trouve ces valeurs dans : Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Clé service role (backend uniquement, ne jamais exposer côté client)
# Supabase dashboard → Project Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Gemini AI ─────────────────────────────────────────────────────────────
# Obtenir une clé : https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIza...
# Modèle à utiliser (ex: gemini-2.0-flash, gemini-2.0-pro-exp-02-05)
GEMINI_MODEL=gemini-2.0-flash

# ── GitHub (optional) ─────────────────────────────────────────────────────
# Optionnel — augmente le rate limit GitHub API de 60 à 5000 req/h
# Créer un token sur : https://github.com/settings/tokens (scope: public_repo)
# GITHUB_TOKEN=ghp_...

# ── App ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
